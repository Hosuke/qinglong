{
 "source": {
  "doc": "T18n0880",
  "title": "瑜伽金剛頂經釋字母品",
  "translator": "唐 不空 譯",
  "edition": "CBETA xml-p5 dbdea41"
 },
 "groups": [
  {
   "title": "摩多 · 元音",
   "id": "mata",
   "letters": [
    {
     "n": 1,
     "iast": "a",
     "zh": "阿",
     "zh_note": "（上）",
     "gate": "一切法本不生故。",
     "ipa": "ɐ",
     "how": "短元音，口微開，舌居中；諸字所含之本音",
     "lb": "0338b19"
    },
    {
     "n": 2,
     "iast": "ā",
     "zh": "阿",
     "zh_note": "（引去）",
     "gate": "一切法寂靜故。",
     "ipa": "aː",
     "how": "長元音，口大開，時長倍於 a",
     "lb": "0338b20"
    },
    {
     "n": 3,
     "iast": "i",
     "zh": "伊",
     "zh_note": "（上）",
     "gate": "一切法根不可得故。",
     "ipa": "i",
     "how": "短，舌前高",
     "lb": "0338b21"
    },
    {
     "n": 4,
     "iast": "ī",
     "zh": "伊",
     "zh_note": "（引去）",
     "gate": "一切法災禍不可得故。",
     "ipa": "iː",
     "how": "長 i",
     "lb": "0338b22"
    },
    {
     "n": 5,
     "iast": "u",
     "zh": "塢",
     "zh_note": null,
     "gate": "一切法譬喻不可得故。",
     "ipa": "u",
     "how": "短，雙唇圓",
     "lb": "0338b23"
    },
    {
     "n": 6,
     "iast": "ū",
     "zh": "污",
     "zh_note": "（引）",
     "gate": "一切法損減不可得故。",
     "ipa": "uː",
     "how": "長 u",
     "lb": "0338b24"
    },
    {
     "n": 7,
     "iast": "ṛ",
     "zh": "哩",
     "zh_note": null,
     "gate": "一切法神通不可得故。",
     "ipa": "r̩",
     "how": "成音節之 r：舌尖輕彈而自成一拍",
     "lb": "0338b25"
    },
    {
     "n": 8,
     "iast": "ṝ",
     "zh": "哩",
     "zh_note": "（引）",
     "gate": "一切法類例不可得故。",
     "ipa": "r̩ː",
     "how": "長 ṛ",
     "lb": "0338b26"
    },
    {
     "n": 9,
     "iast": "ḷ",
     "zh": "〔口＋吕〕",
     "zh_note": null,
     "gate": "一切法染不可得故。",
     "ipa": "l̩",
     "how": "成音節之 l；真言中罕見",
     "lb": "0338b27"
    },
    {
     "n": 10,
     "iast": "ḹ",
     "zh": "𡃖",
     "zh_note": null,
     "gate": "一切法沈沒不可得故。",
     "ipa": "l̩ː",
     "how": "長 ḷ；極罕見",
     "lb": "0338b28"
    },
    {
     "n": 11,
     "iast": "e",
     "zh": "曀",
     "zh_note": null,
     "gate": "一切法求不可得故。",
     "ipa": "eː",
     "how": "恆為長音，口半開",
     "lb": "0338b29"
    },
    {
     "n": 12,
     "iast": "ai",
     "zh": "愛",
     "zh_note": null,
     "gate": "一切法自在不可得故。",
     "ipa": "ɐi",
     "how": "複元音，a→i 滑動",
     "lb": "0338c01"
    },
    {
     "n": 13,
     "iast": "o",
     "zh": "污",
     "zh_note": null,
     "gate": "一切法瀑流不可得故。",
     "ipa": "oː",
     "how": "恆為長音，雙唇圓",
     "lb": "0338c02"
    },
    {
     "n": 14,
     "iast": "au",
     "zh": "奧",
     "zh_note": null,
     "gate": "一切法化生不可得故。",
     "ipa": "ɐu",
     "how": "複元音，a→u 滑動",
     "lb": "0338c03"
    },
    {
     "n": 15,
     "iast": "aṃ",
     "zh": "暗",
     "zh_note": null,
     "gate": "一切法邊際不可得故。",
     "ipa": "ɐ̃ / ɐm",
     "how": "隨韻：元音後之鼻音，隨後字之部位而成 m、n、ŋ",
     "lb": "0338c04"
    },
    {
     "n": 16,
     "iast": "aḥ",
     "zh": "惡",
     "zh_note": null,
     "gate": "一切法遠離不可得故。",
     "ipa": "ɐh",
     "how": "止聲：元音後輕送一息，或帶前元音之回聲（aḥ→aha）",
     "lb": "0338c05"
    }
   ]
  },
  {
   "title": "喉聲 · 舌根",
   "id": "kantha",
   "letters": [
    {
     "n": 17,
     "iast": "ka",
     "zh": "迦",
     "zh_note": "（上）",
     "gate": "一切法離作業故。",
     "ipa": "k",
     "how": "舌根，不送氣清塞音。＝拼音 g 之音值；勿讀成送氣",
     "lb": "0338c06"
    },
    {
     "n": 18,
     "iast": "kha",
     "zh": "佉",
     "zh_note": "（上）",
     "gate": "一切法等虛空不可得故。",
     "ipa": "kʰ",
     "how": "舌根，送氣清塞音。＝拼音 k 之音值",
     "lb": "0338c07"
    },
    {
     "n": 19,
     "iast": "ga",
     "zh": "誐",
     "zh_note": "（上）",
     "gate": "一切法行不可得故。",
     "ipa": "g",
     "how": "舌根，濁塞音：聲帶先振而後破。普通話無此音",
     "lb": "0338c08"
    },
    {
     "n": 20,
     "iast": "gha",
     "zh": "伽",
     "zh_note": "（去引）",
     "gate": "一切法一合不可得故。",
     "ipa": "gʱ",
     "how": "舌根，濁送氣：g 破後帶氣息",
     "lb": "0338c09"
    },
    {
     "n": 21,
     "iast": "ṅa",
     "zh": "仰",
     "zh_note": "（鼻呼）",
     "gate": "一切法支分不可得故。",
     "ipa": "ŋ",
     "how": "舌根鼻音",
     "lb": "0338c10"
    }
   ]
  },
  {
   "title": "齶聲 · 舌面",
   "id": "talu",
   "letters": [
    {
     "n": 22,
     "iast": "ca",
     "zh": "左",
     "zh_note": null,
     "gate": "一切法離一切遷變故。",
     "ipa": "c / tɕ",
     "how": "舌面抵硬齶，不送氣。＝拼音 j 之音值",
     "lb": "0338c11"
    },
    {
     "n": 23,
     "iast": "cha",
     "zh": "磋",
     "zh_note": "（上）",
     "gate": "一切法影像不可得故。",
     "ipa": "cʰ / tɕʰ",
     "how": "舌面，送氣。＝拼音 q 之音值",
     "lb": "0338c12"
    },
    {
     "n": 24,
     "iast": "ja",
     "zh": "惹",
     "zh_note": null,
     "gate": "一切法生不可得故。",
     "ipa": "ɟ / dʑ",
     "how": "舌面，濁音。普通話無",
     "lb": "0338c13"
    },
    {
     "n": 25,
     "iast": "jha",
     "zh": "酇",
     "zh_note": "（去）",
     "gate": "一切法戰敵不可得故。",
     "ipa": "ɟʱ",
     "how": "舌面，濁送氣",
     "lb": "0338c14"
    },
    {
     "n": 26,
     "iast": "ña",
     "zh": "穰",
     "zh_note": "（上）",
     "gate": "一切法智不可得故。",
     "ipa": "ɲ",
     "how": "舌面鼻音",
     "lb": "0338c15"
    }
   ]
  },
  {
   "title": "舌聲 · 捲舌",
   "id": "murdha",
   "letters": [
    {
     "n": 27,
     "iast": "ṭa",
     "zh": "吒",
     "zh_note": "（上）",
     "gate": "一切法慢不可得故。",
     "ipa": "ʈ",
     "how": "捲舌：舌尖上翻抵齶頂，不送氣",
     "lb": "0338c16"
    },
    {
     "n": 28,
     "iast": "ṭha",
     "zh": "咤",
     "zh_note": "（上）",
     "gate": "一切法長養不可得故。",
     "ipa": "ʈʰ",
     "how": "捲舌，送氣",
     "lb": "0338c17"
    },
    {
     "n": 29,
     "iast": "ḍa",
     "zh": "拏",
     "zh_note": "（上）",
     "gate": "一切法怨敵不可得故。",
     "ipa": "ɖ",
     "how": "捲舌，濁音",
     "lb": "0338c18"
    },
    {
     "n": 30,
     "iast": "ḍha",
     "zh": "荼",
     "zh_note": "（去）",
     "gate": "一切法執持不可得故。",
     "ipa": "ɖʱ",
     "how": "捲舌，濁送氣",
     "lb": "0338c19"
    },
    {
     "n": 31,
     "iast": "ṇa",
     "zh": "拏",
     "zh_note": "（尼爽反）（鼻呼）",
     "gate": "一切法諍不可得故。",
     "ipa": "ɳ",
     "how": "捲舌鼻音",
     "lb": "0338c20"
    }
   ]
  },
  {
   "title": "齒聲 · 舌尖",
   "id": "danta",
   "letters": [
    {
     "n": 32,
     "iast": "ta",
     "zh": "多",
     "zh_note": "（上）",
     "gate": "一切法如如不可得故。",
     "ipa": "t̪",
     "how": "舌尖抵上齒背，不送氣。近拼音 d 之音值，而部位更前",
     "lb": "0338c21"
    },
    {
     "n": 33,
     "iast": "tha",
     "zh": "他",
     "zh_note": "（上）",
     "gate": "一切法住處不可得故。",
     "ipa": "t̪ʰ",
     "how": "舌尖抵齒，送氣；非英語 th",
     "lb": "0338c22"
    },
    {
     "n": 34,
     "iast": "da",
     "zh": "娜",
     "zh_note": null,
     "gate": "一切法施不可得故。",
     "ipa": "d̪",
     "how": "舌尖抵齒，濁音。普通話無",
     "lb": "0338c23"
    },
    {
     "n": 35,
     "iast": "dha",
     "zh": "馱",
     "zh_note": "（去）",
     "gate": "一切法界不可得故。",
     "ipa": "d̪ʱ",
     "how": "舌尖抵齒，濁送氣",
     "lb": "0338c24"
    },
    {
     "n": 36,
     "iast": "na",
     "zh": "曩",
     "zh_note": null,
     "gate": "一切法名不可得故。",
     "ipa": "n̪",
     "how": "舌尖抵齒之鼻音",
     "lb": "0339a01"
    }
   ]
  },
  {
   "title": "唇聲",
   "id": "ostha",
   "letters": [
    {
     "n": 37,
     "iast": "pa",
     "zh": "跛",
     "zh_note": null,
     "gate": "一切法第一義諦不可得故。",
     "ipa": "p",
     "how": "雙唇，不送氣。＝拼音 b 之音值",
     "lb": "0339a02"
    },
    {
     "n": 38,
     "iast": "pha",
     "zh": "頗",
     "zh_note": null,
     "gate": "一切法不堅，如聚沫故。",
     "ipa": "pʰ",
     "how": "雙唇，送氣。＝拼音 p 之音值；非 f",
     "lb": "0339a03"
    },
    {
     "n": 39,
     "iast": "ba",
     "zh": "麼",
     "zh_note": null,
     "gate": "一切法縛不可得故。",
     "ipa": "b",
     "how": "雙唇，濁音。普通話無",
     "lb": "0339a04"
    },
    {
     "n": 40,
     "iast": "bha",
     "zh": "婆",
     "zh_note": "（去重）",
     "gate": "一切法有不可得故。",
     "ipa": "bʱ",
     "how": "雙唇，濁送氣",
     "lb": "0339a05"
    },
    {
     "n": 41,
     "iast": "ma",
     "zh": "莽",
     "zh_note": null,
     "gate": "一切法吾我不可得故。",
     "ipa": "m",
     "how": "雙唇鼻音",
     "lb": "0339a06"
    }
   ]
  },
  {
   "title": "遍口聲 · 半元音與擦音",
   "id": "antah",
   "letters": [
    {
     "n": 42,
     "iast": "ya",
     "zh": "野",
     "zh_note": null,
     "gate": "一切法乘不可得故。",
     "ipa": "j",
     "how": "半元音，舌面近硬齶",
     "lb": "0339a07"
    },
    {
     "n": 43,
     "iast": "ra",
     "zh": "囉",
     "zh_note": null,
     "gate": "一切法離諸塵染故。",
     "ipa": "ɾ",
     "how": "舌尖輕彈一下",
     "lb": "0339a08"
    },
    {
     "n": 44,
     "iast": "la",
     "zh": "邏",
     "zh_note": null,
     "gate": "一切法相不可得故。",
     "ipa": "l",
     "how": "舌尖邊音",
     "lb": "0339a09"
    },
    {
     "n": 45,
     "iast": "va",
     "zh": "嚩",
     "zh_note": null,
     "gate": "一切法語言道斷故。",
     "ipa": "ʋ",
     "how": "唇齒近音，介於 v 與 w 之間，齒輕觸下唇",
     "lb": "0339a10"
    },
    {
     "n": 46,
     "iast": "śa",
     "zh": "捨",
     "zh_note": null,
     "gate": "一切法本性寂故。",
     "ipa": "ɕ",
     "how": "舌面擦音。＝拼音 x 之音值",
     "lb": "0339a11"
    },
    {
     "n": 47,
     "iast": "ṣa",
     "zh": "灑",
     "zh_note": null,
     "gate": "一切法性鈍故。",
     "ipa": "ʂ",
     "how": "捲舌擦音。近拼音 sh 之音值",
     "lb": "0339a12"
    },
    {
     "n": 48,
     "iast": "sa",
     "zh": "娑",
     "zh_note": "（上）",
     "gate": "一切法一切諦不可得故。",
     "ipa": "s",
     "how": "舌尖擦音",
     "lb": "0339a13"
    },
    {
     "n": 49,
     "iast": "ha",
     "zh": "賀",
     "zh_note": null,
     "gate": "一切法因不可得故。",
     "ipa": "ɦ",
     "how": "濁喉擦音，較拼音 h 輕而帶聲",
     "lb": "0339a14"
    },
    {
     "n": 50,
     "iast": "kṣa",
     "zh": "乞灑",
     "zh_note": "（二合）",
     "gate": "一切法盡不可得故。",
     "ipa": "kʂ",
     "how": "k 與 ṣ 相連；悉曇別成一合字",
     "lb": "0339a15"
    }
   ]
  }
 ]
}